              <desktop5:Verb Id="FluxVault01Add" Clsid="b43c1563-662c-4fa2-a269-15295a9b05e7" />
              <desktop5:Verb Id="FluxVault02ShowVersions" Clsid="5af731bc-67df-4ec5-bc41-91fc89d6a4b9" />
              <desktop5:Verb Id="FluxVault03Remove" Clsid="b530a520-66ef-4a82-b6c4-5aa8f15d0f2e" />
