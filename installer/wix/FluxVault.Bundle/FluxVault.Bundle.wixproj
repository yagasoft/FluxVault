<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputName>FluxVault.Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.1.0</ProductVersion>
    <SuppressValidation>true</SuppressValidation>
    <SuppressSpecificWarnings>1161</SuppressSpecificWarnings>
    <AcceptEula>wix7</AcceptEula>
    <DefineConstants>ReleasePackageRoot=$(ReleasePackageRoot);PublishRoot=$(PublishRoot);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" />
  </ItemGroup>
</Project>
