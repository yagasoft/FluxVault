<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputName>FluxVault.Installer</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.1.0</ProductVersion>
    <SuppressValidation>true</SuppressValidation>
    <SuppressSpecificWarnings>1149</SuppressSpecificWarnings>
    <AcceptEula>wix7</AcceptEula>
    <DefineConstants>PublishRoot=$(PublishRoot);ReleasePackageRoot=$(ReleasePackageRoot);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>
</Project>
