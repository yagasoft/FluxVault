<Window x:Class="FluxVault.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FluxVault"
        Width="560"
        Height="520"
        MinWidth="520"
        MinHeight="460"
        Background="#F4F6F8"
        Icon="Assets/FluxVault.ico"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{Binding AppName}" FontSize="26" FontWeight="SemiBold" Foreground="#202124" />
                <TextBlock Text="{Binding VersionText}" Foreground="#5F6368" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Yagasoft"
                           Foreground="#5F6368"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,3" />
                <Image Source="Assets/YagasoftLogo.png"
                       Width="190"
                       Height="58"
                       Stretch="Uniform"
                       ToolTip="Yagasoft brand logo." />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding CopyrightText}"
                   Foreground="#3C4043"
                   Margin="0,18,0,0" />

        <TextBlock Grid.Row="2"
                   Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Foreground="#202124"
                   Margin="0,14,0,12" />

        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#DADCE0"
                BorderThickness="1"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Button Command="{Binding OpenGitHubCommand}"
                            ToolTip="Open the FluxVault GitHub project in your default browser.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↗" Margin="0,0,6,0" />
                            <TextBlock Text="GitHub project" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="https://github.com/yagasoft/FluxVault" VerticalAlignment="Center" Foreground="#174EA6" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Command="{Binding OpenWebsiteCommand}"
                            ToolTip="Open the Yagasoft website in your default browser.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↗" Margin="0,0,6,0" />
                            <TextBlock Text="Yagasoft website" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="https://yagasoft.com/" VerticalAlignment="Center" Foreground="#174EA6" />
                </StackPanel>

                <ItemsControl Grid.Row="3" ItemsSource="{Binding RoadmapMilestones}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#202124" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}" Foreground="#5F6368" VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Close"
                    IsCancel="True"
                    MinWidth="92"
                    ToolTip="Close the About window." />
        </Grid>
    </Grid>
</Window>
