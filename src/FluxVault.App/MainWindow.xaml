<Window x:Class="FluxVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FluxVault.App.ViewModels"
        mc:Ignorable="d"
        Title="FluxVault" MinHeight="680" MinWidth="1080" Height="760" Width="1220"
        Background="#F4F6F8"
        Icon="Assets/FluxVault.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="520" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,16,0">
                <TextBlock Text="FluxVault" FontSize="26" FontWeight="SemiBold" Foreground="#202124" />
                <TextBlock Text="{Binding ServiceStatus}"
                           FontSize="13"
                           Foreground="#5F6368"
                           Margin="0,3,0,0"
                           MinWidth="0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="640">
                            <TextBlock Text="{Binding ServiceStatusToolTip}" TextWrapping="Wrap" />
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                <Button Content="Options" Click="Options_Click" />
                <Button Content="Run backup now" Command="{Binding RunBackupNowCommand}" />
                <Button Content="Restore" Command="{Binding RestoreSelectedCommand}" />
                <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Columns="4">
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                <TextBlock Text="{Binding UsnHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="640">
                            <TextBlock Text="{Binding UsnHealthToolTip}" TextWrapping="Wrap" />
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                <TextBlock Text="{Binding RetentionHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124" />
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                <TextBlock Text="{Binding MirrorHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124" />
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10">
                <TextBlock Text="{Binding CaptureHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124" />
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="4" TabStripPlacement="Left" Background="#FFFFFF" BorderBrush="#DADCE0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Width" Value="132" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="Protection">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8" Padding="8" />
                    <Button Grid.Row="0" Grid.Column="1" Content="Repository" Command="{Binding BrowseRepositoryCommand}" Margin="0,0,0,8" />
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MirrorPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" Padding="8" />
                    <Button Grid.Row="1" Grid.Column="1" Content="Mirror" Command="{Binding BrowseMirrorCommand}" Margin="0" />

                    <DataGrid Grid.Row="3" Grid.ColumnSpan="2" ItemsSource="{Binding WatchedFolders}" SelectedItem="{Binding SelectedWatchedFolder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding ResourceProfile}" Width="120" />
                            <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="130" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="File browser">
                <Grid Margin="18" Name="FileBrowserPaneGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Refresh drives"
                                Command="{Binding FileBrowser.RefreshRootsCommand}"
                                ToolTip="Reload drives and top-level folders in the file browser." />
                        <Button Content="Cycle folder selection"
                                Command="{Binding FileBrowser.ToggleSelectedFolderCommand}"
                                ToolTip="Cycle the selected folder between recursive, immediate files only, and not selected." />
                        <Button Content="Save selections"
                                Command="{Binding SaveConfigurationCommand}"
                                ToolTip="Save pending File browser selections to the service configuration." />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#DADCE0" BorderThickness="1" Background="#FFFFFF" Margin="0,0,10,0">
                        <TreeView ItemsSource="{Binding FileBrowser.Roots}"
                                  SelectedItemChanged="FileBrowserTree_SelectedItemChanged"
                                  ToolTip="Browse drives and folders. Use the selection button on each folder to cycle protection mode.">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FileBrowserFolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding SelectionGlyph}"
                                                Width="72"
                                                Padding="4,2"
                                                Margin="0,0,6,0"
                                                Click="FolderSelection_Click"
                                                ToolTip="Cycle this folder between recursive, immediate files only, and not selected." />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <Style TargetType="TreeViewItem">
                                    <EventSetter Event="Expanded" Handler="FileBrowserFolder_Expanded" />
                                </Style>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Grid.Column="1"
                              ItemsSource="{Binding FileBrowser.Files}"
                              ToolTip="Files in the selected folder. Check a file to protect only that file.">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Length}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="1"
                              Grid.Column="2"
                              ItemsSource="{Binding FileBrowser.PendingChanges}"
                              ToolTip="Unsaved File browser selection changes. Press Save selections to apply them.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="90" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Repository">
                <Grid Margin="18">
                    <DataGrid ItemsSource="{Binding RecentVersions}" SelectedItem="{Binding SelectedVersion}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionId}" Width="220" />
                            <DataGridTextColumn Header="File" Binding="{Binding SourcePath}" Width="*" />
                            <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="170" />
                            <DataGridTextColumn Header="Consistency" Binding="{Binding Consistency}" Width="140" />
                            <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Activity">
                <Grid Margin="18">
                    <DataGrid ItemsSource="{Binding CaptureStatuses}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Blocked">
                                        <Setter Property="Background" Value="#FFF4CE" />
                                        <Setter Property="Foreground" Value="#7A4B00" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding SourcePath}" Width="*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150" />
                            <DataGridTextColumn Header="Last event" Binding="{Binding LastEvent}" Width="170" />
                            <DataGridTextColumn Header="Forced by" Binding="{Binding NextForcedCapture}" Width="170" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Options">
                <Grid Margin="18">
                    <StackPanel>
                        <Button Content="Open options" Click="Options_Click" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding CaptureHealth}" Foreground="#3C4043" />
                        <TextBlock Text="{Binding RetentionHealth}" Foreground="#3C4043" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="18">
                    <TextBox Text="{Binding DiagnosticsText}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                             BorderBrush="#DADCE0" Padding="12" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
