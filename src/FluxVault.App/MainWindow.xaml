<Window x:Class="FluxVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FluxVault.App.ViewModels"
        mc:Ignorable="d"
        Title="FluxVault" MinHeight="680" MinWidth="1080" Height="760" Width="1220"
        Background="#F4F6F8"
        Icon="Assets/FluxVault.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="520" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
    </Window.Resources>

    <Grid Name="OperationalCockpitShell" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,16,0">
                <TextBlock Text="FluxVault" FontSize="26" FontWeight="SemiBold" Foreground="#202124" />
                <TextBlock Text="{Binding ServiceStatus}"
                           FontSize="13"
                           Foreground="#5F6368"
                           Margin="0,3,0,0"
                           MinWidth="0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="640">
                            <TextBlock Text="{Binding ServiceStatusToolTip}" TextWrapping="Wrap" />
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
                <Border Name="ServiceAvailabilityWarning"
                        Background="#FFF4CE"
                        BorderBrush="#F0B429"
                        BorderThickness="1"
                        Padding="8,5"
                        Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsServiceWarningVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ServiceWarningText}"
                               Foreground="#7A4B00"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Name="OperationalCockpitCommandBar" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh dashboard status and version data.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Name="ServiceControlToggleButton"
                        Command="{Binding ToggleWindowsServiceCommand}"
                        IsEnabled="{Binding IsServiceControlActionEnabled}"
                        ToolTip="{Binding ServiceControlToolTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ServiceControlActionLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RunBackupNowCommand}" ToolTip="Run a full scan backup now.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↥" Margin="0,0,6,0" />
                        <TextBlock Text="Run backup now" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RestoreSelectedCommand}" ToolTip="Restore the selected repository version.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↙" Margin="0,0,6,0" />
                        <TextBlock Text="Restore" />
                    </StackPanel>
                </Button>
                <Button Click="Options_Click" ToolTip="Open retention, maintenance, capture, compression, and Explorer settings.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" Margin="0,0,6,0" />
                        <TextBlock Text="Options" />
                    </StackPanel>
                </Button>
                <Button Click="About_Click" ToolTip="About FluxVault.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ⓘ" Margin="0,0,6,0" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportDiagnosticsCommand}" ToolTip="Export local service status, diagnostics, and health details.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣" Margin="0,0,6,0" />
                        <TextBlock Text="Export diagnostics" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2"
                    Name="OperationalCockpitWorkspace"
                    SelectedIndex="{Binding SelectedWorkspaceIndex}"
                    TabStripPlacement="Left"
                    Background="#FFFFFF"
                    BorderBrush="#DADCE0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Width" Value="132" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </TabControl.Resources>

            <TabItem Header="🛡 Protection">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,8" Padding="8" />
                    <Button Grid.Row="0" Grid.Column="1" Content="Repository" Command="{Binding BrowseRepositoryCommand}" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" Padding="8"
                            BorderBrush="#DADCE0" BorderThickness="1" Background="#F8F9FA">
                        <TextBlock Text="{Binding MirrorSummary}" TextWrapping="Wrap" />
                    </Border>
                    <Button Grid.Row="1" Grid.Column="1" Content="Open Mirrors" Command="{Binding OpenMirrorsWorkspaceCommand}" Margin="0" />

                    <DataGrid Grid.Row="3" Grid.ColumnSpan="2" ItemsSource="{Binding WatchedFolders}" SelectedItem="{Binding SelectedWatchedFolder}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Profile" Binding="{Binding ResourceProfile}" Width="120" />
                            <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="130" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="300" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📁 File browser">
                <Grid Margin="18" Name="FileBrowserPaneGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Refresh drives"
                                Command="{Binding FileBrowser.RefreshRootsCommand}"
                                ToolTip="Reload drives and top-level folders in the file browser." />
                        <Button Content="Cycle folder selection"
                                Command="{Binding FileBrowser.ToggleSelectedFolderCommand}"
                                ToolTip="Cycle the selected folder between recursive, immediate files only, and not selected." />
                        <Button Content="Save selections"
                                Command="{Binding SaveConfigurationCommand}"
                                ToolTip="Save pending File browser selections to the service configuration." />
                        <Button Content="Discard changes"
                                Command="{Binding DiscardConfigurationChangesCommand}"
                                ToolTip="Discard unsaved File browser and configuration edits, then reload settings from the service." />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#DADCE0" BorderThickness="1" Background="#FAFBFC" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Workload preset" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding FileBrowser.WorkloadPresets}"
                                      SelectedValue="{Binding FileBrowser.SelectedWorkloadPreset}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="DisplayName"
                                      Padding="6"
                                      Margin="0,0,12,8"
                                      ToolTip="Built-in conservative workload policy for the selected protected folder or file." />
                            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
                                       Text="{Binding FileBrowser.SelectedWorkloadPresetDescription}"
                                       Foreground="#5F6368"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Include regex" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding FileBrowser.SelectedIncludeRegexText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7"
                                     Margin="0,0,12,8"
                                     ToolTip="One .NET regex per line. Inherited include regex rules are additive." />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Exclude regex" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="3"
                                     Text="{Binding FileBrowser.SelectedExcludeRegexText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="7"
                                     Margin="0,0,12,8"
                                     ToolTip="One .NET regex per line. Exclude rules from selected parents and children are additive." />
                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Apply regex"
                                        Command="{Binding FileBrowser.ApplySelectedRegexRulesCommand}"
                                        ToolTip="Apply the regex lists to the currently selected protected folder or file." />
                                <Button Content="Clear regex"
                                        Command="{Binding FileBrowser.ClearSelectedRegexRulesCommand}"
                                        ToolTip="Clear local regex lists from the currently selected protected folder or file." />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="5"
                                       Text="{Binding FileBrowser.SelectedRegexStatus}"
                                       Foreground="#5F6368"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#DADCE0" BorderThickness="1" Background="#FFFFFF" Margin="0,0,10,0" MinWidth="0">
                        <TreeView ItemsSource="{Binding FileBrowser.Roots}"
                                  SelectedItemChanged="FileBrowserTree_SelectedItemChanged"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Show in File Explorer"
                                              Command="{Binding FileBrowser.ShowSelectedFolderInExplorerCommand}" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:FileBrowserFolderNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Width="32"
                                                Padding="4,2"
                                                Margin="0,0,6,0"
                                                Click="FolderSelection_Click"
                                                ToolTip="{Binding SelectionToolTip}">
                                            <TextBlock Text="{Binding SelectionIndicator}" HorizontalAlignment="Center" />
                                        </Button>
                                        <TextBlock Text="{Binding RegexIndicator}"
                                                   ToolTip="{Binding RegexToolTip}"
                                                   Width="18"
                                                   Foreground="#A05A00"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <Style TargetType="TreeViewItem">
                                    <EventSetter Event="Expanded" Handler="FileBrowserFolder_Expanded" />
                                </Style>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>

                    <DataGrid Grid.Row="2"
                              Grid.Column="1"
                              Name="FileBrowserFilesGrid"
                              MinWidth="0"
                              Margin="0,0,10,0"
                              ItemsSource="{Binding FileBrowser.Files}"
                              SelectedItem="{Binding FileBrowser.SelectedFile}"
                              Loaded="FileBrowserGrid_Loaded"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ToolTip="Files in the selected folder. Check a file to protect only that file.">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Open in default app"
                                          Command="{Binding FileBrowser.OpenSelectedFileCommand}" />
                                <MenuItem Header="Show in File Explorer"
                                          Command="{Binding FileBrowser.ShowSelectedFileInExplorerCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Selected" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="SizeToCells" MinWidth="90" />
                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="SizeToCells" MinWidth="160" />
                            <DataGridTextColumn Header="Bytes" Binding="{Binding Length}" Width="SizeToCells" MinWidth="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Grid.Row="2"
                              Grid.Column="2"
                              Name="FileBrowserPendingChangesGrid"
                              MinWidth="0"
                              ItemsSource="{Binding FileBrowser.PendingChanges}"
                              Loaded="FileBrowserGrid_Loaded"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ToolTip="Unsaved File browser selection changes. Press Save selections to apply them.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="SizeToCells" MinWidth="90" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="SizeToCells" MinWidth="180" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="SizeToCells" MinWidth="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🧱 Repository">
                <Grid Margin="18">
                    <DataGrid ItemsSource="{Binding RecentVersions}" SelectedItem="{Binding SelectedVersion}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionId}" Width="220" />
                            <DataGridTextColumn Header="File" Binding="{Binding SourcePath}" Width="*" />
                            <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="170" />
                            <DataGridTextColumn Header="Consistency" Binding="{Binding Consistency}" Width="140" />
                            <DataGridTextColumn Header="Lineage" Binding="{Binding Lineage}" Width="190" />
                            <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="🪞 Mirrors">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MirrorSummary}" VerticalAlignment="Center" Foreground="#3C4043" Margin="0,0,12,0" />
                        <Button Content="Add mirror" Command="{Binding AddMirrorCommand}" Margin="0,0,8,0"
                                ToolTip="Add a full-copy mirror node." />
                        <Button Content="Browse path" Command="{Binding BrowseSelectedMirrorCommand}" Margin="0,0,8,0"
                                ToolTip="Choose the folder for the selected mirror node." />
                        <Button Content="Remove mirror" Command="{Binding RemoveMirrorCommand}"
                                ToolTip="Remove the selected mirror node from configuration." />
                    </StackPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding MirrorNodes}"
                              SelectedItem="{Binding SelectedMirrorNode}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              ToolTip="Configured full-copy mirror nodes.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding Status}" Width="150" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save mirrors" Command="{Binding SaveConfigurationCommand}" Margin="0,0,8,0"
                                ToolTip="Save mirror configuration." />
                        <Button Content="Discard changes" Command="{Binding DiscardConfigurationChangesCommand}"
                                ToolTip="Reload mirror configuration from the service." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="↯ Activity">
                <Grid Margin="18">
                    <DataGrid ItemsSource="{Binding CaptureStatuses}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Blocked">
                                        <Setter Property="Background" Value="#FFF4CE" />
                                        <Setter Property="Foreground" Value="#7A4B00" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding SourcePath}" Width="*" />
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="150" />
                            <DataGridTextColumn Header="Last event" Binding="{Binding LastEvent}" Width="170" />
                            <DataGridTextColumn Header="Forced by" Binding="{Binding NextForcedCapture}" Width="170" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="⚙ Options">
                <Grid Margin="18">
                    <StackPanel>
                        <Button Content="Open options" Click="Options_Click" Width="140" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding CaptureHealth}" Foreground="#3C4043" />
                        <TextBlock Text="{Binding RetentionHealth}" Foreground="#3C4043" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="▣ Diagnostics">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" MinWidth="0">
                            <TextBlock Text="{Binding RepositoryHealthStatus}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#202124"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiagnosticsText}"
                                       Foreground="#5F6368"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <Button Content="Run scrub"
                                    Command="{Binding RunRepositoryScrubCommand}"
                                    ToolTip="Check referenced repository and mirror artefacts, repairing from a healthy counterpart when possible." />
                            <Button Content="Run restore rehearsal"
                                    Command="{Binding RunRestoreRehearsalCommand}"
                                    ToolTip="Restore recent versions to a temporary FluxVault folder, verify length, then delete the temporary output." />
                            <Button Content="Export diagnostics"
                                    Command="{Binding ExportDiagnosticsCommand}"
                                    ToolTip="Export local service status, diagnostics, and health details." />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding RepositoryHealthRows}"
                              ToolTip="Repository health, mirror, USN, blocked-file, scrub, and restore rehearsal status.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Area" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBox Grid.Row="4"
                             Text="{Binding DiagnosticsText}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             BorderBrush="#DADCE0"
                             Padding="12" />
                </Grid>
            </TabItem>
        </TabControl>

        <UniformGrid Grid.Row="4" Name="FooterHealthBar" Columns="4">
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                <TextBlock Text="{Binding UsnHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="640">
                            <TextBlock Text="{Binding UsnHealthToolTip}" TextWrapping="Wrap" />
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                <TextBlock Text="{Binding RetentionHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124" />
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10" Margin="0,0,8,0">
                <TextBlock Text="{Binding MirrorHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124" />
            </Border>
            <Border Background="#FFFFFF" BorderBrush="#DADCE0" BorderThickness="1" Padding="10">
                <TextBlock Text="{Binding CaptureHealth}" TextTrimming="CharacterEllipsis" Foreground="#202124" />
            </Border>
        </UniformGrid>
    </Grid>
</Window>
