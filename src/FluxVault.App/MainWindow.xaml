<Window x:Class="FluxVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FluxVault" MinHeight="680" MinWidth="1040" Height="760" Width="1180"
        Background="#F6F7F9">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="FluxVault" FontSize="28" FontWeight="SemiBold" Foreground="#202124" />
                <TextBlock Text="{Binding ServiceStatus}" FontSize="14" Foreground="#5F6368" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="16,8" Margin="8,0,0,0" />
                <Button Content="Run backup now" Command="{Binding RunBackupNowCommand}" Padding="16,8" Margin="8,0,0,0" />
                <Button Content="Restore" Command="{Binding RestoreSelectedCommand}" Padding="16,8" Margin="8,0,0,0" />
                <Button Content="Export diagnostics" Command="{Binding ExportDiagnosticsCommand}" Padding="16,8" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#DADCE0">
            <TabItem Header="Protection">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,8" Padding="8" />
                        <Button Grid.Row="0" Grid.Column="1" Content="Repository" Command="{Binding BrowseRepositoryCommand}"
                                Padding="14,8" Margin="0,0,0,8" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MirrorPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,12" Padding="8" />
                        <Button Grid.Row="1" Grid.Column="1" Content="Mirror" Command="{Binding BrowseMirrorCommand}"
                                Padding="14,8" Margin="0,0,0,12" />

                        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBox Text="{Binding NewWatchedFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         Width="460" Padding="8" Margin="0,0,8,0" />
                                <Button Content="Browse" Command="{Binding BrowseWatchedFolderCommand}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="Add" Command="{Binding AddWatchedFolderCommand}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="Remove" Command="{Binding RemoveWatchedFolderCommand}" Padding="14,8" Margin="0,0,8,0" />
                                <Button Content="Save" Command="{Binding SaveConfigurationCommand}" Padding="14,8" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding WatchedFolders}" SelectedItem="{Binding SelectedWatchedFolder}"
                                      AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Folder" Binding="{Binding Path}" Width="*" />
                                    <DataGridTextColumn Header="Profile" Binding="{Binding ResourceProfile}" Width="120" />
                                    <DataGridTextColumn Header="Compression" Binding="{Binding Compression}" Width="140" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MVP capture strategy" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CaptureStrategy}" TextWrapping="Wrap" Margin="0,10,0,18" Foreground="#3C4043" />
                        <TextBlock Text="Resource profiles" FontSize="18" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding ResourceProfiles}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="#3C4043" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Repository">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding RepositorySummary}" TextWrapping="Wrap" FontSize="15" Foreground="#3C4043" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentVersions}" SelectedItem="{Binding SelectedVersion}" AutoGenerateColumns="False"
                              CanUserAddRows="False" IsReadOnly="True" Margin="0,18,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionId}" Width="220" />
                            <DataGridTextColumn Header="File" Binding="{Binding SourcePath}" Width="*" />
                            <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="180" />
                            <DataGridTextColumn Header="Consistency" Binding="{Binding Consistency}" Width="160" />
                            <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <Grid Margin="20">
                    <TextBox Text="{Binding DiagnosticsText}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                             BorderBrush="#DADCE0" Padding="12" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
