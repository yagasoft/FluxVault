<Window x:Class="FluxVault.App.MirrorNodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        MinWidth="560"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#202124" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Label" VerticalAlignment="Center" />
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                     Padding="7" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Path" VerticalAlignment="Center" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                     Padding="7"
                     Margin="0,0,8,0" />
            <Button Grid.Row="2"
                    Grid.Column="2"
                    Content="Browse"
                    Click="Browse_Click"
                    ToolTip="Choose the mirror folder." />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Enabled" VerticalAlignment="Center" />
            <CheckBox Grid.Row="4"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      IsChecked="{Binding IsEnabled}"
                      VerticalAlignment="Center"
                      ToolTip="Enable this mirror for placement, repair, and drain operations." />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Capacity bytes" VerticalAlignment="Center" />
            <TextBox Grid.Row="6"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Text="{Binding CapacityBudgetBytesText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="7"
                     ToolTip="Optional positive byte budget for capacity-aware placement. Leave blank for no budget." />

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Priority" VerticalAlignment="Center" />
            <TextBox Grid.Row="8"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                     Padding="7"
                     ToolTip="Lower values are preferred first when placement needs to choose between mirrors." />

            <TextBlock Grid.Row="10"
                       Grid.ColumnSpan="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="#A05A00"
                       TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Click="Cancel_Click"
                    ToolTip="Close without changing mirror configuration." />
            <Button Content="{Binding PrimaryButtonText}"
                    Click="Accept_Click"
                    ToolTip="Apply these mirror parameters." />
        </StackPanel>
    </Grid>
</Window>
