<Window x:Class="FluxVault.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxVault options" Height="660" Width="720" MinHeight="620" MinWidth="640"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        ToolTipService.ShowDuration="30000"
        Loaded="OptionsWindow_Loaded">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Placement" Value="Mouse" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="460" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Name="OptionsShell" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Options" FontSize="24" FontWeight="SemiBold" Foreground="#202124" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="#5F6368" />
        </StackPanel>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#DADCE0">
            <TabItem Header="Basic">
                <ScrollViewer Name="BasicOptionsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Enable automatic retention"
                                  IsChecked="{Binding RetentionEnabled}" Margin="0,0,0,14"
                                  ToolTip="Run repository retention automatically after successful backups." />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Keep every version for" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="Dense retention window in hours. Every committed version is preserved during this period." />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeepAllHours, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                                 ToolTip="Number of hours to keep every version before older versions are thinned." />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Keep hourly versions for days" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="After the dense window, keep one version per hour for this many days." />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeepHourlyDays, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                                 ToolTip="Number of days where FluxVault keeps one representative version per hour." />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Keep daily versions for days" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="After the hourly window, keep one version per day for this many days." />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeepDailyDays, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                                 ToolTip="Number of days where FluxVault keeps one representative version per day." />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Minimum versions per file" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="Safety floor. FluxVault never prunes below this many latest versions per source file." />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MinimumVersionsPerFile, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                                 ToolTip="Minimum number of latest versions to keep for each protected file, regardless of age." />

                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Repository maintenance" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Run repository maintenance automatically"
                                  IsChecked="{Binding MaintenanceRunAutomatically}" Margin="0,0,0,14"
                                  ToolTip="Run repository scrub and restore rehearsal automatically on the configured interval. Manual diagnostics actions remain available when this is off." />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Maintenance interval hours" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="Minimum number of hours between scheduled repository scrub and restore rehearsal runs." />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding MaintenanceIntervalHours, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                                 ToolTip="FluxVault clamps this to at least 1 hour." />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Restore rehearsal versions" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="Number of newest versions to restore into a temporary FluxVault-owned folder during rehearsal." />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding RestoreRehearsalVersionCount, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                                 ToolTip="Use 0 to disable version rehearsal while keeping repository scrub enabled." />

                        <CheckBox Grid.Row="10" Grid.ColumnSpan="2" Content="Repair automatically from mirror"
                                  IsChecked="{Binding MaintenanceAutoRepairFromMirror}" Margin="0,0,0,0"
                                  ToolTip="Repair repository artefacts from a healthy mirror copy, and repair mirror drift from a healthy primary copy." />

                        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="Workload presets" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="13" Grid.Column="0" Text="Default workload preset" VerticalAlignment="Center" Margin="0,0,14,10"
                                   ToolTip="Preset used for newly selected folders and files from the File browser or Explorer Add action." />
                        <ComboBox Grid.Row="13" Grid.Column="1"
                                  ItemsSource="{Binding WorkloadPresets}"
                                  SelectedValue="{Binding DefaultWorkloadPreset}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName"
                                  Padding="6"
                                  Margin="0,0,0,10"
                                  ToolTip="Choose the conservative built-in workload policy assigned to new protection selections." />

                        <Border Grid.Row="15" Grid.ColumnSpan="2" BorderBrush="#DADCE0" BorderThickness="1" Background="#FFFFFF" Padding="12">
                            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Foreground="#3C4043" />
                        </Border>

                        <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Preview" Command="{Binding PreviewRetentionCommand}" Padding="14,8" Margin="0,0,8,0"
                                    ToolTip="Calculate what retention would prune without deleting anything." />
                            <Button Content="Run retention now" Command="{Binding RunRetentionNowCommand}" Padding="14,8"
                                    ToolTip="Apply the current retention policy and remove pruned manifests and orphaned chunks." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Storage">
                <ScrollViewer Name="StorageOptionsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Metadata database" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="Provider" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Database engine used for FluxVault metadata." />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding MetadataStoreProviders}"
                                  SelectedItem="{Binding MetadataStoreProvider}"
                                  Padding="6"
                                  Margin="0,0,0,8"
                                  ToolTip="PostgreSQL is the supported whole-PC metadata store." />

                        <TextBlock Grid.Row="2" Text="Host / port" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Local PostgreSQL endpoint used by the FluxVault service." />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding MetadataStoreHost, UpdateSourceTrigger=PropertyChanged}" Width="210" Padding="8"
                                     ToolTip="PostgreSQL host name or address." />
                            <TextBox Text="{Binding MetadataStorePort, UpdateSourceTrigger=PropertyChanged}" Width="82" Padding="8" Margin="8,0,0,0"
                                     ToolTip="PostgreSQL TCP port." />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Database name" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="FluxVault metadata database name." />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MetadataStoreDatabaseName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Database created for FluxVault metadata tables." />

                        <TextBlock Grid.Row="4" Text="User name" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Database role used by the FluxVault service." />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MetadataStoreUsername, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="PostgreSQL login name. Passwords are not stored in this options payload." />

                        <TextBlock Grid.Row="5" Text="Service name" VerticalAlignment="Center" Margin="0,0,14,0"
                                   ToolTip="Windows service name used by maintenance scripts when checking PostgreSQL availability." />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MetadataStoreServiceName, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                                 ToolTip="Typical value is postgresql-x64 or the installed version-specific service name." />

                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Metadata backup" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="8" Text="Backup directory" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Directory where the backup script writes pg_dump files and metadata recovery bundles." />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding MetadataStoreBackupDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Use a path outside the repository if you want reinstall recovery independent from vault storage." />

                        <TextBlock Grid.Row="9" Text="Backup retention days" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Number of days to keep generated metadata database backup files." />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MetadataStoreBackupRetentionDays, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Older backup files are removed by the backup script." />

                        <TextBlock Grid.Row="10" Text="Export lag warning minutes" VerticalAlignment="Center" Margin="0,0,14,0"
                                   ToolTip="Warn when committed metadata has not been exported to replayable operation files within this window." />
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding MetadataStoreExportLagWarningMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                                 ToolTip="Outbox lag threshold for future metadata journal export health." />

                        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="Concurrency" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="13" Text="Capture workers / DB writers" VerticalAlignment="Center" Margin="0,0,14,0"
                                   ToolTip="Worker and database writer limits for whole-PC ingest." />
                        <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding MetadataStoreMaxCaptureWorkers, UpdateSourceTrigger=PropertyChanged}" Width="82" Padding="8"
                                     ToolTip="Maximum metadata-aware capture workers." />
                            <TextBox Text="{Binding MetadataStoreMaxDbWriterConcurrency, UpdateSourceTrigger=PropertyChanged}" Width="82" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Maximum concurrent database writer operations allowed by FluxVault." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer Name="AdvancedOptionsScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Capture cadence" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="Watcher poll seconds" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="How often the service wakes to process queued file-system events." />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WatcherPollSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Seconds between lightweight watcher queue checks." />
                        <TextBlock Grid.Row="2" Text="Reconciliation minutes" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Safety-net full scan interval used when watcher or USN events are missed or unavailable." />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PeriodicReconciliationMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Minutes between reconciliation scans of watched folders." />
                        <TextBlock Grid.Row="3" Text="Debounce fast / balanced / quiet" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Quiet-window delay before capturing changed files for each resource profile." />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding FastDebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8"
                                     ToolTip="Fast profile debounce in seconds." />
                            <TextBox Text="{Binding BalancedDebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Balanced profile debounce in seconds." />
                            <TextBox Text="{Binding QuietDebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Quiet profile debounce in seconds." />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="Max hot delay fast / balanced / quiet" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Maximum time a constantly changing file may wait before FluxVault takes a snapshot anyway." />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding FastMaxHotFileDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8"
                                     ToolTip="Fast profile maximum hot-file delay in seconds." />
                            <TextBox Text="{Binding BalancedMaxHotFileDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Balanced profile maximum hot-file delay in minutes." />
                            <TextBox Text="{Binding QuietMaxHotFileDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Quiet profile maximum hot-file delay in minutes." />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Minimum same-file interval seconds" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Minimum time between captures of the same file, preventing hot files from thrashing the disk." />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MinimumSameFileCaptureIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Seconds FluxVault waits before capturing the same file again." />
                        <TextBlock Grid.Row="6" Text="Maximum concurrent captures" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Maximum number of files the service captures in parallel." />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MaximumConcurrentCaptures, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Parallel capture limit. Keep this low for less disruption." />
                        <TextBlock Grid.Row="7" Text="Watcher event backlog limit" VerticalAlignment="Center" Margin="0,0,14,18"
                                    ToolTip="Maximum queued watcher paths before FluxVault collapses the event storm into one reconciliation scan." />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding WatcherEventBacklogLimit, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,18"
                                  ToolTip="Higher values allow more targeted fallbacks; lower values cap OneDrive or Office event churn faster." />

                        <TextBlock Grid.Row="8" Text="USN fallback cooldown minutes" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Minimum time between full reconciliation scans caused by repeated USN reset or unavailable states." />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding UsnFallbackFullScanCooldownMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Repeated USN fallback scans are suppressed for this many minutes unless an explicit backup or event overflow requires a scan." />
                        <TextBlock Grid.Row="9" Text="Deep verification interval hours" VerticalAlignment="Center" Margin="0,0,14,18"
                                   ToolTip="How often maintenance may perform deeper source verification instead of trusting length and last-write metadata." />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding SourceDeepVerificationIntervalHours, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,18"
                                 ToolTip="Normal scans skip unchanged files by metadata; this interval controls scheduled deeper verification." />

                        <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="Compression" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="11" Text="Profile / default / hot-file" VerticalAlignment="Center" Margin="0,0,14,8"
                                    ToolTip="Compression policy profile, normal codec, and hot-file override." />
                        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding CodecProfiles}" SelectedItem="{Binding CodecProfile}" Width="120"
                                      ToolTip="Adaptive skips or lowers compression for unsuitable files; ratio-focused profiles spend more CPU." />
                            <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding DefaultCodec}" Width="110" Margin="8,0,0,0"
                                      ToolTip="Default codec for normal captures under the selected profile." />
                            <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding HotFileCodec}" Width="110" Margin="8,0,0,0"
                                      ToolTip="Codec override for hot files. LZ4 or off keeps capture latency lower." />
                        </StackPanel>
                        <TextBlock Grid.Row="12" Text="Level / minimum KB" VerticalAlignment="Center" Margin="0,0,14,0"
                                    ToolTip="Compression effort level and minimum chunk size before compression is attempted." />
                        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding CodecLevel, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8"
                                     ToolTip="Codec effort level. Higher values may improve ratio but use more CPU." />
                            <TextBox Text="{Binding CodecMinimumKb, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Chunks smaller than this size are stored without compression." />
                        </StackPanel>

                        <TextBlock Grid.Row="13" Text="Skip extensions" VerticalAlignment="Top" Margin="0,0,14,18"
                                    ToolTip="File extensions that are already compressed or not worth compressing. Separate entries with new lines, commas, or semicolons." />
                        <TextBox Grid.Row="13" Grid.Column="1"
                                 Text="{Binding CodecSkipExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="86"
                                 Padding="8"
                                 Margin="0,0,0,18"
                                 ToolTip="FluxVault normalises entries to extensions such as .zip and removes duplicates when saving." />

                        <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Text="Diagnostics" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <CheckBox Grid.Row="16" Grid.ColumnSpan="2"
                                  Content="Enable service file logging"
                                  IsChecked="{Binding DiagnosticsFileLoggingEnabled}"
                                  Margin="0,0,0,8"
                                  ToolTip="Write bounded rolling FluxVault service logs under the configured diagnostics directory." />
                        <TextBlock Grid.Row="17" Text="Service file log level" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Minimum level written to rolling service files. Warning is the default; Trace is for diagnostic runs." />
                        <ComboBox Grid.Row="17" Grid.Column="1"
                                  ItemsSource="{Binding DiagnosticLogLevels}"
                                  SelectedItem="{Binding DiagnosticsFileLogLevel}"
                                  Padding="6"
                                  Margin="0,0,0,8"
                                  ToolTip="Trace captures detailed loop, IPC, and capture decisions. Event Log remains less verbose." />
                        <TextBlock Grid.Row="18" Text="Log directory" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Directory for rolling JSONL service log files." />
                        <TextBox Grid.Row="18" Grid.Column="1"
                                 Text="{Binding DiagnosticsLogDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8"
                                 Margin="0,0,0,8"
                                 ToolTip="Default is C:\ProgramData\FluxVault\logs." />
                        <TextBlock Grid.Row="19" Text="Max MB / retained files" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Hard cap for each log file and number of rolled files retained." />
                        <StackPanel Grid.Row="19" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding DiagnosticsMaxLogFileMegabytes, UpdateSourceTrigger=PropertyChanged}" Width="82" Padding="8"
                                     ToolTip="Maximum size per JSONL log file in megabytes." />
                            <TextBox Text="{Binding DiagnosticsRetainedLogFileCount, UpdateSourceTrigger=PropertyChanged}" Width="82" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Number of rolled service log files to retain." />
                        </StackPanel>
                        <TextBlock Grid.Row="20" Text="Telemetry seconds / samples" VerticalAlignment="Center" Margin="0,0,14,18"
                                   ToolTip="Always-on resource sample interval and capped in-memory sample history." />
                        <StackPanel Grid.Row="20" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBox Text="{Binding TelemetrySampleIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="82" Padding="8"
                                     ToolTip="Seconds between service telemetry samples." />
                            <TextBox Text="{Binding TelemetryRetainedSampleCount, UpdateSourceTrigger=PropertyChanged}" Width="96" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Maximum samples retained in memory for the Performance tab." />
                        </StackPanel>

                        <TextBlock Grid.Row="22" Grid.ColumnSpan="2" Text="Explorer context menu" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="23" Grid.ColumnSpan="2" Text="{Binding ExplorerContextMenuStatus}" Foreground="#3C4043" TextWrapping="Wrap" Margin="0,0,0,8"
                                   ToolTip="Current per-user Explorer full-menu and Windows 11 compact-menu registration status." />
                        <StackPanel Grid.Row="24" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="RegisterExplorerContextMenuButton"
                                    Content="Register Explorer menu"
                                    Command="{Binding RegisterExplorerContextMenuCommand}"
                                    Padding="14,8" Margin="0,0,8,0"
                                    ToolTip="Register per-user file and folder Explorer actions for add, show versions, and remove." />
                            <Button Name="UnregisterExplorerContextMenuButton"
                                    Content="Unregister Explorer menu"
                                    Command="{Binding UnregisterExplorerContextMenuCommand}"
                                    Padding="14,8"
                                    ToolTip="Remove FluxVault per-user file and folder actions from Explorer." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4" Name="OptionsStickyFooter" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,8" Margin="0,0,8,0"
                    ToolTip="Save the current retention, maintenance, workload, storage, cadence, compression, and Explorer options to the service configuration." />
            <Button Content="Close" Click="Close_Click" Padding="16,8"
                    ToolTip="Close Options without applying any unsaved changes." />
        </StackPanel>
    </Grid>
</Window>
