<Window x:Class="FluxVault.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxVault options" Height="520" Width="620" MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        ToolTipService.ShowDuration="30000"
        Loaded="OptionsWindow_Loaded">
    <Window.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Placement" Value="Mouse" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="460" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Options" FontSize="24" FontWeight="SemiBold" Foreground="#202124" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" Foreground="#5F6368" />
        </StackPanel>

        <TabControl Grid.Row="2" Background="White" BorderBrush="#DADCE0">
            <TabItem Header="Basic">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="Enable automatic retention"
                              IsChecked="{Binding RetentionEnabled}" Margin="0,0,0,14"
                              ToolTip="Run repository retention automatically after successful backups." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Keep every version for" VerticalAlignment="Center" Margin="0,0,14,10"
                               ToolTip="Dense retention window in hours. Every committed version is preserved during this period." />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeepAllHours, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                             ToolTip="Number of hours to keep every version before older versions are thinned." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Keep hourly versions for days" VerticalAlignment="Center" Margin="0,0,14,10"
                               ToolTip="After the dense window, keep one version per hour for this many days." />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding KeepHourlyDays, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                             ToolTip="Number of days where FluxVault keeps one representative version per hour." />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Keep daily versions for days" VerticalAlignment="Center" Margin="0,0,14,10"
                               ToolTip="After the hourly window, keep one version per day for this many days." />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KeepDailyDays, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                             ToolTip="Number of days where FluxVault keeps one representative version per day." />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Minimum versions per file" VerticalAlignment="Center" Margin="0,0,14,10"
                               ToolTip="Safety floor. FluxVault never prunes below this many latest versions per source file." />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MinimumVersionsPerFile, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,10"
                             ToolTip="Minimum number of latest versions to keep for each protected file, regardless of age." />

                    <Border Grid.Row="6" Grid.ColumnSpan="2" BorderBrush="#DADCE0" BorderThickness="1" Background="#FFFFFF" Padding="12">
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Foreground="#3C4043" />
                    </Border>

                    <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Preview" Command="{Binding PreviewRetentionCommand}" Padding="14,8" Margin="0,0,8,0"
                                ToolTip="Calculate what retention would prune without deleting anything." />
                        <Button Content="Run retention now" Command="{Binding RunRetentionNowCommand}" Padding="14,8"
                                ToolTip="Apply the current retention policy and remove pruned manifests and orphaned chunks." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer Margin="18" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="160" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Capture cadence" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="1" Text="Watcher poll seconds" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="How often the service wakes to process queued file-system events." />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WatcherPollSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Seconds between lightweight watcher queue checks." />
                        <TextBlock Grid.Row="2" Text="Reconciliation minutes" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Safety-net full scan interval used when watcher or USN events are missed or unavailable." />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PeriodicReconciliationMinutes, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Minutes between reconciliation scans of watched folders." />
                        <TextBlock Grid.Row="3" Text="Debounce fast / balanced / quiet" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Quiet-window delay before capturing changed files for each resource profile." />
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding FastDebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8"
                                     ToolTip="Fast profile debounce in seconds." />
                            <TextBox Text="{Binding BalancedDebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Balanced profile debounce in seconds." />
                            <TextBox Text="{Binding QuietDebounceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Quiet profile debounce in seconds." />
                        </StackPanel>
                        <TextBlock Grid.Row="4" Text="Max hot delay fast / balanced / quiet" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Maximum time a constantly changing file may wait before FluxVault takes a snapshot anyway." />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding FastMaxHotFileDelaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8"
                                     ToolTip="Fast profile maximum hot-file delay in seconds." />
                            <TextBox Text="{Binding BalancedMaxHotFileDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Balanced profile maximum hot-file delay in minutes." />
                            <TextBox Text="{Binding QuietMaxHotFileDelayMinutes, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Quiet profile maximum hot-file delay in minutes." />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Minimum same-file interval seconds" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Minimum time between captures of the same file, preventing hot files from thrashing the disk." />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MinimumSameFileCaptureIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,8"
                                 ToolTip="Seconds FluxVault waits before capturing the same file again." />
                        <TextBlock Grid.Row="6" Text="Maximum concurrent captures" VerticalAlignment="Center" Margin="0,0,14,18"
                                   ToolTip="Maximum number of files the service captures in parallel." />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MaximumConcurrentCaptures, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,18"
                                 ToolTip="Parallel capture limit. Keep this low for less disruption." />

                        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Compression" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="8" Text="Profile / default / hot-file" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Compression policy profile, normal codec, and hot-file override." />
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding CodecProfiles}" SelectedItem="{Binding CodecProfile}" Width="120"
                                      ToolTip="Adaptive skips or lowers compression for unsuitable files; ratio-focused profiles spend more CPU." />
                            <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding DefaultCodec}" Width="110" Margin="8,0,0,0"
                                      ToolTip="Default codec for normal captures under the selected profile." />
                            <ComboBox ItemsSource="{Binding Codecs}" SelectedItem="{Binding HotFileCodec}" Width="110" Margin="8,0,0,0"
                                      ToolTip="Codec override for hot files. LZ4 or off keeps capture latency lower." />
                        </StackPanel>
                        <TextBlock Grid.Row="9" Text="Level / minimum KB" VerticalAlignment="Center" Margin="0,0,14,0"
                                   ToolTip="Compression effort level and minimum chunk size before compression is attempted." />
                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding CodecLevel, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="8"
                                     ToolTip="Codec effort level. Higher values may improve ratio but use more CPU." />
                            <TextBox Text="{Binding CodecMinimumKb, UpdateSourceTrigger=PropertyChanged}" Width="90" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Chunks smaller than this size are stored without compression." />
                        </StackPanel>

                        <TextBlock Grid.Row="11" Grid.ColumnSpan="2" Text="Explorer context menu" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="{Binding ExplorerContextMenuStatus}" Foreground="#3C4043" TextWrapping="Wrap" Margin="0,0,0,8"
                                   ToolTip="Current per-user Explorer context-menu registration status." />
                        <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="RegisterExplorerContextMenuButton"
                                    Content="Register Explorer menu"
                                    Command="{Binding RegisterExplorerContextMenuCommand}"
                                    Padding="14,8" Margin="0,0,8,0"
                                    ToolTip="Register per-user file and folder Explorer actions that open FluxVault with the selected path as a restore hint." />
                            <Button Name="UnregisterExplorerContextMenuButton"
                                    Content="Unregister Explorer menu"
                                    Command="{Binding UnregisterExplorerContextMenuCommand}"
                                    Padding="14,8"
                                    ToolTip="Remove FluxVault per-user file and folder actions from Explorer." />
                        </StackPanel>

                        <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Text="Path exclusions" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Grid.Row="16" Text="Label / regex pattern" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Optional label and .NET regex matched against full normalised local paths." />
                        <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding NewExclusionLabel, UpdateSourceTrigger=PropertyChanged}" Width="120" Padding="8"
                                     ToolTip="Optional friendly label for this exclusion rule." />
                            <TextBox Text="{Binding NewExclusionPattern, UpdateSourceTrigger=PropertyChanged}" Width="260" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Case-insensitive .NET regex. It is matched against full paths, not only file names." />
                        </StackPanel>
                        <TextBlock Grid.Row="17" Text="Target / description" VerticalAlignment="Center" Margin="0,0,14,8"
                                   ToolTip="Choose whether this regex excludes files, folders, or both, and optionally describe why." />
                        <StackPanel Grid.Row="17" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox ItemsSource="{Binding ExclusionTargets}" SelectedItem="{Binding NewExclusionTarget}" Width="120"
                                      ToolTip="Folder exclusions also stop recursive scans from descending into matching folders." />
                            <TextBox Text="{Binding NewExclusionDescription, UpdateSourceTrigger=PropertyChanged}" Width="268" Padding="8" Margin="8,0,0,0"
                                     ToolTip="Optional support note explaining why this path pattern is excluded." />
                        </StackPanel>
                        <StackPanel Grid.Row="18" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Button Content="Add exclusion" Command="{Binding AddExclusionRuleCommand}" Padding="14,8" Margin="0,0,8,0"
                                    ToolTip="Validate and add this exclusion rule to the pending Options changes." />
                            <Button Content="Remove selected" Command="{Binding RemoveSelectedExclusionRuleCommand}" Padding="14,8"
                                    ToolTip="Remove the selected exclusion rule from the pending Options changes." />
                        </StackPanel>
                        <DataGrid Grid.Row="19" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding ExclusionRules}"
                                  SelectedItem="{Binding SelectedExclusionRule}"
                                  ToolTip="Configured exclusion regex rules. Save options to apply changes to the service.">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="70" />
                                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="80" />
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="120" />
                                <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,8" Margin="0,0,8,0"
                    ToolTip="Save the current retention, cadence, and compression options to the service configuration." />
            <Button Content="Close" Click="Close_Click" Padding="16,8"
                    ToolTip="Close Options without applying any unsaved changes." />
        </StackPanel>
    </Grid>
</Window>
