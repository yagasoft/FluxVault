<Window x:Class="FluxVault.App.ProtectedFolderVersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Version history"
        MinHeight="520"
        MinWidth="980"
        Height="640"
        Width="1120"
        Background="#F4F6F8">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding FolderPath}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Versions}"
                      SelectedItem="{Binding SelectedVersion}"
                      MouseDoubleClick="VersionsGrid_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="150" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="320" />
                    <DataGridTextColumn Header="Lineage" Binding="{Binding Lineage}" Width="120" />
                    <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding SnapshotEntries}"
                      SelectedItem="{Binding SelectedSnapshotEntry}"
                      MouseDoubleClick="SnapshotGrid_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="360" />
                    <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="150" />
                    <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Preview version"
                    Command="{Binding PreviewSelectedVersionCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Restore version"
                    Command="{Binding RestoreSelectedVersionCommand}"
                    Margin="0,0,18,0" />
            <Button Content="Open"
                    Command="{Binding OpenSelectedSnapshotEntryCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Preview file"
                    Command="{Binding PreviewSelectedSnapshotEntryCommand}"
                    Margin="0,0,8,0" />
            <Button Content="Restore selected"
                    Command="{Binding RestoreSelectedSnapshotEntryCommand}" />
        </StackPanel>
    </Grid>
</Window>
