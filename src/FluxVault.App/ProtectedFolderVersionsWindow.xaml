<Window x:Class="FluxVault.App.ProtectedFolderVersionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protected folder versions"
        MinHeight="420"
        MinWidth="860"
        Height="520"
        Width="960"
        Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="#DADCE0" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding FolderPath}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Files}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton Content=">"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                          Width="26"
                                          Padding="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="File" Binding="{Binding File}" Width="220" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="360" />
                <DataGridTextColumn Header="Latest version" Binding="{Binding LatestVersionId}" Width="220" />
                <DataGridTextColumn Header="Latest captured" Binding="{Binding LatestCapturedAt}" Width="160" />
                <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="100" />
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DADCE0" BorderThickness="0,1,0,1" Padding="36,8,8,8" Background="#FAFBFC">
                        <DataGrid ItemsSource="{Binding Versions}"
                                  MouseDoubleClick="VersionsGrid_MouseDoubleClick"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Version" Binding="{Binding VersionId}" Width="220" />
                                <DataGridTextColumn Header="Captured" Binding="{Binding CapturedAt}" Width="160" />
                                <DataGridTextColumn Header="Consistency" Binding="{Binding Consistency}" Width="130" />
                                <DataGridTextColumn Header="Lineage" Binding="{Binding Lineage}" Width="140" />
                                <DataGridTextColumn Header="Bytes" Binding="{Binding Bytes}" Width="100" />
                                <DataGridTextColumn Header="Chunks" Binding="{Binding ChunkCount}" Width="80" />
                                <DataGridTemplateColumn Header="Restore" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Restore"
                                                    Command="{Binding DataContext.RestoreVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</Window>
